# MongoDB Atlas connection string (server-side only)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/siri_constructions?retryWrites=true&w=majority

# Use a randomly generated 32+ character value in production.
AUTH_SECRET=replace-with-a-long-random-session-secret

# Used only to securely provision the first administrator on their first login.
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "require('bcryptjs').hash('replace-with-a-strong-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-password-hash
